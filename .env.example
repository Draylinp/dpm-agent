# Copie este archivo a .env y complete los valores. Nunca suba .env al repositorio (está en .gitignore).
# Los nombres con "__" son ajustes de appsettings.json (Seccion__Clave). Ver docs/INSTALLATION.md.

# --- Obligatorios -------------------------------------------------------------------------------
# Clave de la Meta Model API (Muse Spark, Muse Voice Transcribe, lectura del carnet).
META_API_KEY=
# Clave de la base PostgreSQL de docker compose (larga y aleatoria).
POSTGRES_PASSWORD=
# Clave de la secretaria inicial (usuario "secretaria", rol admin). Mínimo 10 caracteres.
Panel__ClaveInicial=

# --- Generales ----------------------------------------------------------------------------------
# Puerto del equipo donde se abre la app (http://localhost:8080).
PUERTO=8080
# Consultorio de ejemplo con datos ficticios al crear la base vacía. En un consultorio real: false.
BaseDatos__SembrarDatosDemo=true

# --- Modelo -------------------------------------------------------------------------------------
# MetaApi u OpenAICompatible (Muse Glimmer u otro servidor compatible). Respaldo: vacío o el otro.
Modelo__Proveedor=MetaApi
Modelo__Respaldo=
Meta__Model=muse-spark-1.2
Meta__BaseUrl=https://api.meta.ai/v1/
Transcripcion__Modelo=muse-voice-transcribe-1.0
# Vacío: el servicio detecta el idioma de la nota de voz.
Transcripcion__Idioma=
# Vacío: usa Meta__Model.
Carnet__Modelo=

# Servidor compatible con OpenAI (Muse Glimmer). Con el perfil "glimmer": http://glimmer:8000/v1/
OpenAICompatible__BaseUrl=http://glimmer:8000/v1/
OpenAICompatible__Model=
OpenAICompatible__ApiKey=

# --- Muse Glimmer local (perfil "glimmer", necesita GPU NVIDIA de 24 GB o más) ------------------
# Repo de Hugging Face del modelo y parser de herramientas de vLLM (ver docs/GLIMMER.md).
GLIMMER_MODELO=
GLIMMER_TOOL_PARSER=
GLIMMER_MAX_LEN=16384
HF_TOKEN=
# Imagen de vLLM; revise si hay una versión más nueva.
VLLM_IMAGEN=vllm/vllm-openai:v0.10.1

# --- Filtro de seguridad de salida --------------------------------------------------------------
# Modelo (el mismo modelo como clasificador), LlamaGuard o Reglas. Ver docs/OUTPUT-FILTER.md.
FiltroSalida__Proveedor=Modelo
FiltroSalida__BaseUrl=
FiltroSalida__Model=
FiltroSalida__ApiKey=
FiltroSalida__BloquearSiFalla=false

# --- WhatsApp Cloud API (opcional) — ver docs/WHATSAPP.md --------------------------------------
WhatsApp__AccessToken=
WhatsApp__AppSecret=
WhatsApp__VerifyToken=
WhatsApp__PhoneNumberId=
WhatsApp__Plantillas__oferta=
WhatsApp__Plantillas__oferta_vencida=
WhatsApp__Plantillas__recordatorio=
WhatsApp__Plantillas__seguimiento_creado=
WhatsApp__Plantillas__seguimiento_agendado=
WhatsApp__Plantillas__seguimiento_contacto=
WhatsApp__Plantillas__recordatorio_7dias=
WhatsApp__Plantillas__resumen_medico=

# --- Agenda ---------------------------------------------------------------------------------------
Agenda__OfertaMinutos=30
Agenda__RecordatorioHorasAntes=24
# Seguimientos indicados por el médico: intentos de contacto, días entre intentos y recordatorio extra (días antes).
Agenda__SeguimientoIntentos=3
Agenda__SeguimientoDiasEntreIntentos=3
Agenda__SeguimientoRecordatorioDiasAntes=7

# --- Límites y retención ------------------------------------------------------------------------
Limites__PeticionesPorMinutoPorIp=120
Limites__MensajesPorMinutoPorSesion=12
# true solo si hay un proxy HTTPS delante que fije X-Forwarded-For (Caddy, nginx, App Service).
Limites__ConfiarEncabezadosReenviados=false
Retencion__DiasConversaciones=30
Retencion__DiasBitacora=365

# --- Canal del médico — el médico se reconoce solo por WhatsApp con su número verificado --------------
# true únicamente en la demo (en el chat web el número es simulado).
CanalMedico__PermitirChatWeb=false

# --- Demo pública (opcional) — ver docs/DEMO.md --------------------------------------------------
Demo__Habilitado=false
Demo__MensajesPorDiaPorIp=40
Demo__ClavePanel=

# --- Cumplimiento — ver docs/WHATSAPP.md ----------------------------------------------------
# Dirección pública del aviso de privacidad que aparece en el texto de consentimiento (en producción, https://...).
Cumplimiento__UrlPrivacidad=/privacidad.html

# --- Costos — ver docs/COSTS.md ---------------------------------------------------------------------
# Los precios por modelo llevan "-" y "." en el nombre: configúrelos en appsettings.json o con
# un docker-compose.override.yml (ver docs/COSTS.md). Aquí solo la moneda.
Precios__Moneda=USD

# --- Evaluación (tools/DpmAgent.Eval) — ver docs/EVALUATION.md ----------------------------------
Eval__Juez__BaseUrl=
Eval__Juez__Model=
Eval__Juez__ApiKey=
