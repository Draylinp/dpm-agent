{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Dpm": "Data Source=dpm-agent.db"
  },
  "BaseDatos": {
    "Proveedor": "Sqlite",
    "MigrarAlIniciar": true,
    "SembrarDatosDemo": true,
    "ConsultorioId": 1
  },
  "Meta": {
    "BaseUrl": "https://api.meta.ai/v1/",
    "Model": "muse-spark-1.2",
    "MaxCompletionTokens": 1024,
    "Temperature": 0.2,
    "TimeoutSeconds": 60
  },
  "Transcripcion": {
    "Modelo": "muse-voice-transcribe-1.0",
    "Ruta": "audio/transcriptions",
    "Idioma": "es",
    "MaxBytes": 2097152,
    "MaxDuracionSegundos": 120,
    "TimeoutSeconds": 60
  },
  "Carnet": {
    "Modelo": "",
    "MaxBytes": 4194304,
    "TimeoutSeconds": 60
  },
  "Agenda": {
    "MotorActivo": true,
    "IntervaloSegundos": 15,
    "OfertaMinutos": 30,
    "AnticipacionMinimaMinutos": 60,
    "RecordatorioHorasAntes": 24
  }
}
